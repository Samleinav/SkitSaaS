# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
POSTGRES_URL=postgresql://***
# Optional: admin DB role with elevated access (BYPASSRLS). Used by /admin area.
# If omitted, adminDb falls back to POSTGRES_URL (single-role local dev).
# See docs/operations/rls-setup.md for full setup guide.
ADMIN_POSTGRES_URL=
# Optional: set these only when Stripe payments are enabled.
# If omitted (or left empty), app uses DB values from /admin/app-config.
STRIPE_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: set these only when PayPal payments are enabled.
# If omitted (or left empty), app uses DB values from /admin/app-config.
PAYPAL_ENABLED=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
# Optional organization policy overrides (env has priority over DB):
TEAMS_ENABLED=true
# Optional signup subscription policy overrides (env has priority over DB fallback
# values stored in /admin/app-config/general):
# Published signup defaults may be zero-cost (direct sign-up) or paid
# (`signup_intent` + checkout before the real account is created).
SIGNUP_DEFAULT_ORGANIZATION_TEMPLATE_ID=
SIGNUP_DEFAULT_USER_TEMPLATE_ID=
SIGNUP_PUBLIC_FREE_ORGANIZATION_TEMPLATE_ID=
SIGNUP_PUBLIC_FREE_USER_TEMPLATE_ID=
# baseline | public_free
SIGNUP_FAILURE_FALLBACK_MODE=baseline
ALLOW_MULTI_ORGANIZATIONS=false
MAX_ORGANIZATIONS_PER_USER=
# Optional theme policy overrides (env has priority over DB):
THEME_MODE=system
THEME_ALLOW_USER_OVERRIDE=true
THEME_ADMIN=theme.first.backoffice
THEME_DASHBOARD=theme.first.backoffice
THEME_FRONTEND=theme.first.frontend
# Optional performance diagnostics (server logs):
# PERF_DIAGNOSTICS=true
# PERF_DIAGNOSTICS_SCOPES=admin,theme
# Optional: set these for external SMTP delivery (App Config > Email fallback).
# Local SMTP hosts (localhost/127.0.0.1) are blocked by default.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=S-Kit-SaaS
SMTP_REPLY_TO_EMAIL=
BASE_URL=http://localhost:3000
AUTH_SECRET=***
# Login policy by area: password (passkey/social require auth modules)
AUTH_ADMIN_LOGIN_METHODS=password
AUTH_DASHBOARD_LOGIN_METHODS=password
# Optional break-glass admin policy (leave AUTH_BREAK_GLASS_EMAILS empty to disable).
AUTH_BREAK_GLASS_EMAILS=
# Enforce passkey-only for break-glass accounts.
AUTH_BREAK_GLASS_REQUIRE_PASSKEY=true
# Emergency fallback (temporary): allow password login for break-glass accounts.
AUTH_BREAK_GLASS_ALLOW_PASSWORD_BYPASS=false
# Optional comma-separated exact IP allowlist for break-glass password attempts.
AUTH_BREAK_GLASS_ALLOWED_IPS=
# Break-glass brute-force controls.
AUTH_BREAK_GLASS_MAX_ATTEMPTS=5
AUTH_BREAK_GLASS_WINDOW_SECONDS=900
AUTH_BREAK_GLASS_LOCKOUT_SECONDS=1800
# Deployment surface mode:
# - full: admin + dashboard + frontend
# - dashboard-only: dashboard + frontend (admin disabled)
# - admin-only: admin only (dashboard/frontend disabled)
APP_SURFACE_MODE=full
# Seed controls:
# ALLOW_PRODUCTION_SEED=true is required only for controlled one-time seed in production-like environments.
ALLOW_PRODUCTION_SEED=false
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_TEAM_NAME=
# Runtime feature flags (modules)
FF_USE_APP_MODULES_RUNTIME=true
FF_USE_MODULE_DISPATCHER_ROUTES=true
# Optional app runtime config overrides:
# - APP_PROJECT_NAME overrides app.config.ts projectName
# - MODULE_RUNTIME_MODE overrides app.config.ts moduleRuntimeMode (db|config|hybrid)
# - ACTIVE_MODULES_ENABLE / ACTIVE_MODULES_DISABLE override app.config.ts modules flags
APP_PROJECT_NAME=
MODULE_RUNTIME_MODE=
ACTIVE_MODULES_ENABLE=
ACTIVE_MODULES_DISABLE=
# Optional: events/hooks queue (Redis).
# If unset or Redis is unavailable, events run inline.
# EVENTS_REDIS_URL overrides REDIS_URL when both are set.
EVENTS_REDIS_URL=
# REDIS_URL=
# Optional: show only specific modules in /admin dashboard.
# ADMIN_DASHBOARD_ENABLED_MODULES=overview,quickLinks,recentActivity
# mod.artificial.scientist
# When true, the module falls back to deterministic local outputs if cloud
# providers are not configured or temporarily unavailable.
MOD_SCIENTIST_ALLOW_MOCK_PIPELINE=true
# Local fallback storage for compressed run artifacts when S3 is not configured.
MOD_SCIENTIST_LOCAL_STORAGE_ROOT=./storage/mod.artificial.scientist
# Optional S3 / compatible storage for run artifacts.
MOD_SCIENTIST_S3_BUCKET=
MOD_SCIENTIST_S3_REGION=us-east-1
MOD_SCIENTIST_S3_ACCESS_KEY_ID=
MOD_SCIENTIST_S3_SECRET_ACCESS_KEY=
MOD_SCIENTIST_S3_KMS_KEY_ID=
MOD_SCIENTIST_S3_ENDPOINT=
# Google BigQuery PubMed access.
BIGQUERY_PROJECT_ID=
BIGQUERY_CREDENTIALS_JSON=
BIGQUERY_PUBMED_DATASET=bigquery-public-data.pubmed
# AWS Bedrock models by agent/tier.
BEDROCK_REGION=us-east-1
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_FAST_AGENT12=amazon.nova-lite-v1:0
BEDROCK_STANDARD_AGENT12=openai.gpt-oss-120b
BEDROCK_DEEP_AGENT12=moonshot.kimi-k2-thinking
BEDROCK_AGENT3_FAST=us.anthropic.claude-sonnet-4-6
BEDROCK_AGENT3_STANDARD=us.anthropic.claude-sonnet-4-6
BEDROCK_AGENT3_DEEP=us.anthropic.claude-opus-4-6
BEDROCK_AGENT4_FAST=us.anthropic.claude-sonnet-4-6
BEDROCK_AGENT4_STANDARD=us.anthropic.claude-opus-4-6
BEDROCK_AGENT4_DEEP=us.anthropic.claude-opus-4-6
# ── Sfiles (File Management) ─────────────────────────────────────────────────
# Storage backend: local (default) or s3
SFILES_BACKEND=local
# Local backend: root directory for file storage
SFILES_LOCAL_ROOT=./storage/sfiles
# Base URL for local file serving (used to build /api/sfiles/serve/* URLs)
SFILES_URL_BASE=http://localhost:3000
# Default signed URL expiry in seconds (for S3 backend)
SFILES_SIGNED_URL_EXPIRES=3600
# S3 / compatible backend (MinIO, Cloudflare R2, etc.)
# Leave empty when using local backend
SFILES_S3_BUCKET=
SFILES_S3_REGION=us-east-1
SFILES_S3_ACCESS_KEY_ID=
SFILES_S3_SECRET_ACCESS_KEY=
# Optional: custom S3-compatible endpoint (MinIO, R2, etc.)
SFILES_S3_ENDPOINT=
