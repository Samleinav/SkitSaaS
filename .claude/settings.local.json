{
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "0",
    "AWS_REGION": "us-east-1"
  },
  "permissions": {
    "allow": [
      "Bash(ls -la /d/GitHub/saas-starter/app/\\\\\\(frontend\\\\\\)/)",
      "Bash(ls -la /d/GitHub/saas-starter/app/\\\\\\(dashboard\\\\\\)/admin/)",
      "Bash(ls -la /d/GitHub/saas-starter/app/\\\\\\(dashboard\\\\\\)/dashboard/)",
      "Bash(find /d/GitHub/saas-starter/modules -name \"module.json\" -exec head -30 {} ;)",
      "Bash(find \"/d/GitHub/saas-starter/app/\\(login\\)\" -type d)",
      "Bash(find \"/d/GitHub/saas-starter/app/\\(login\\)\" -type f)",
      "Bash(pnpm typecheck)"
    ]
  },
  "model": "global.anthropic.claude-opus-4-6-v1",
  "ANTHROPIC_DEFAULT_OPUS_MODEL": "global.anthropic.claude-opus-4-6-v1",
  "ANTHROPIC_DEFAULT_SONNET_MODEL": "global.anthropic.claude-sonnet-4-6",
  "ANTHROPIC_DEFAULT_HAIKU_MODEL": "global.anthropic.claude-haiku-4-5-20251001-v1:0"
}
