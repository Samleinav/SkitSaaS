{
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_REGION": "us-east-1",
    "ANTHROPIC_MODEL": "us.anthropic.claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "us.anthropic.claude-opus-4-6-v1",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "us.anthropic.claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "us.anthropic.claude-haiku-4-5-20251001-v1:0"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Bash(git:*)",
      "Bash(npm run test:*)",
      "Bash(ls:*)",
      "WebFetch",
      "Bash(pnpm build)",
      "Bash(npm run build)",
      "Bash(cat /app/serviceentomai/s-kit-saas/app/\\\\\\(dashboard\\\\\\)/admin/orders/[orderId]/edit/page.tsx)",
      "Bash(pnpm install)",
      "Bash(/app/serviceentomai/s-kit-saas/docs/meta.json:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm modules:prepare)",
      "Bash(find /d/GitHub/saas-starter -type f -name *AGENTS*)",
      "Bash(pnpm typecheck:*)"
    ]
  }
}
